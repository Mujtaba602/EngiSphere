    // ── Event Delegation — all dynamic buttons ────────────────────────────
    document.addEventListener('click', function(e) {
        // Open Details
        const detailsBtn = e.target.closest('.open-details-btn, .btn-open-details, [data-action="open-details"]');
        if (detailsBtn) {
            e.preventDefault();
            e.stopPropagation();
            const projectId = detailsBtn.dataset.projectId
                || detailsBtn.closest('[data-project-id]')?.dataset.projectId
                || 'demo';
            localStorage.setItem('selectedProjectId', projectId);
            localStorage.setItem('engisphere-selected-project', projectId);
            window.location.href = 'project_details.html';
            return;
        }

        // Focus
        const focusBtn = e.target.closest('.focus-btn, .btn-focus, [data-action="focus-project"]');
        if (focusBtn) {
            e.preventDefault();
            e.stopPropagation();
            const projectId = focusBtn.dataset.projectId
                || focusBtn.closest('[data-project-id]')?.dataset.projectId;
            if (projectId) focusProjectOnMap(projectId);
            return;
        }

        // Generate AI Solution (delegation fallback)
        const genBtn = e.target.closest('.ai-generate-btn, .generate-btn, [data-action="generate-solution"]');
        if (genBtn) {
            e.preventDefault();
            e.stopPropagation();
            generateLocalAISolution();
            return;
        }

        // Back to Dashboard
        const backBtn = e.target.closest('[data-action="back-dashboard"], .back-dashboard-btn');
        if (backBtn && !backBtn.href) {
            e.preventDefault();
            window.location.href = 'index.html';
            return;
        }

        // Open AI EngiBot
        const aiBtn = e.target.closest('[data-action="open-ai"], .open-ai-btn');
        if (aiBtn && !aiBtn.href) {
            e.preventDefault();
            window.location.href = 'ai_chat.html';
            return;
        }
    });

    // ── Theme toggle — use the app-wide toggle from theme.js ──────────────
    document.getElementById('themeToggleBtn')?.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.toggleEngiSphereTheme === 'function') {
            window.toggleEngiSphereTheme();
        }
    });

    // Expose allProjects for focusProjectOnMap
    Object.defineProperty(window, 'projects', {
        get: () => allProjects,
        configurable: true
    });

    initPage();
</script>

<script>
/* =========================================================
   GLOBAL BUTTON FUNCTIONS — guaranteed accessible
   ========================================================= */

window.focusProjectOnMap = function(projectId) {
    console.log('[Focus] clicked:', projectId);

    // Coordinates keyed by project id from fallback list
    const fallbackCoords = {
        'PRJ-0001': [25.2048, 55.2708],
        'PRJ-0002': [24.7136, 46.6753],
        'PRJ-0003': [25.2854, 51.5310],
        'PRJ-0004': [30.0444, 31.2357],
        'PRJ-0005': [24.7743, 46.7386],
        'PRJ-0006': [24.6877, 46.7219]
    };

    // 1. Try window.projects (from Object.defineProperty getter)
    const list = (window.projects && window.projects.length ? window.projects : null) || [];
    const project = list.find(p => String(p.id) === String(projectId));

    // 2. Resolve coordinates
    const coords = (project && project.coordinates)
        || (project && project.lat && project.lng ? [Number(project.lat), Number(project.lng)] : null)
        || fallbackCoords[String(projectId)]
        || null;

    if (!coords) {
        console.warn('[Focus] No coordinates found for:', projectId);
        return false;
    }

    // 3. Get map instance
    const mapObj = window.map || window.engisphereMap;
    if (!mapObj || typeof mapObj.setView !== 'function') {
        console.warn('[Focus] Map not available on window.map');
        return false;
    }

    // 4. Fly to location
    mapObj.setView(coords, 9, { animate: true, duration: 0.8 });

    // 5. Open popup if marker exposed
    if (window.projectMarkers && window.projectMarkers[String(projectId)]) {
        setTimeout(function() {
            window.projectMarkers[String(projectId)].openPopup();
        }, 500);
    }

    return false;
};

window.generateLocalAISolution = function() {
    console.log('[AI] generateLocalAISolution called');

    // Prefer selected project from allProjects
    let selectedTitle = 'Selected Project';
    let selectedLoc   = 'the project site';
    try {
        const projectsList = (typeof allProjects !== 'undefined' ? allProjects : null) || [];
        const activeId = typeof activeProjectId !== 'undefined' ? activeProjectId : null;
        const proj = activeId ? projectsList.find(p => String(p.id) === String(activeId)) : projectsList[0];
        if (proj) {
            selectedTitle = proj.title || proj.name || selectedTitle;
            selectedLoc   = proj.location || selectedLoc;
        }
    } catch(e) {}

    const output = document.getElementById('aiSolutionOutput');
    const btn    = document.getElementById('aiGenerateBtn');

    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
    }

    setTimeout(function() {
        if (output) {
            output.innerHTML = `
                <div class="solution-scroll-body">
                    <h4>Project Diagnosis</h4>
                    <p>The project "${selectedTitle}" in ${selectedLoc} requires focused monitoring, risk control, and clear recovery actions based on its current progress and risk level.</p>
                    <h4>Root Causes</h4>
                    <ul>
                        <li>Limited visibility into site progress and operational risks.</li>
                        <li>Possible delays caused by resources, dependencies, or approvals.</li>
                        <li>Risk indicators require active management attention.</li>
                    </ul>
                    <h4>Immediate Actions</h4>
                    <ul>
                        <li>Review the project schedule and critical path.</li>
                        <li>Assign accountable owners for high-risk activities.</li>
                        <li>Increase the frequency of progress reporting and site check-ins.</li>
                    </ul>
                    <h4>AI Recommendations</h4>
                    <ul>
                        <li>Use AI-assisted monitoring for early risk detection.</li>
                        <li>Track progress, cost, and safety indicators in one dashboard.</li>
                        <li>Escalate unresolved issues before they affect delivery timelines.</li>
                    </ul>
                </div>`;
        }
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-brain"></i> Generate AI Solution Map';
        }
        // Show success toast if available
        if (typeof showToast === 'function') {
            showToast('AI solution map generated (demo mode).', 'success');
        }
    }, 600);
};
</script>
</body>
</html>

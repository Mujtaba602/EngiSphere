            <a href="project_details.html" class="nav-link">
                <i class="fas fa-folder-open"></i>
                <span>Project Details</span>
            </a>

            <a href="team_access.html" class="nav-link">
                <i class="fas fa-users-gear"></i>
                <span>Team Access</span>
            </a>

            <a href="reports.html" class="nav-link">
                <i class="fas fa-file-invoice"></i>
                <span>Reports</span>
            </a>
        </nav>

        <a href="login.html" class="nav-link exit-link">
            <i class="fas fa-power-off"></i>
            <span>Exit System</span>
        </a>
    </aside>

    <button id="sidebarToggle" class="sidebar-toggle" title="Toggle Sidebar">
        <i class="fas fa-chevron-left"></i>
    </button>

    <main class="main-content">
        <div class="topbar">
            <div class="topbar-left">
                <h1>Geospatial Radar</h1>
                <p>AI-powered geospatial intelligence for engineering project monitoring and risk detection.</p>
            </div>
            <div class="topbar-right">
                <div id="notificationCenter"></div>
                <a href="index.html" class="top-btn" data-action="back-dashboard">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
                <a href="ai_chat.html" class="top-btn primary" data-action="open-ai">
                    <i class="fas fa-robot"></i> Open AI EngiBot
                </a>
                <button type="button" class="theme-toggle" id="themeToggleBtn" title="Light mode" style="background:var(--panel); border:1px solid var(--border); border-radius:12px; width:42px; height:42px; color:var(--text); cursor:pointer;">
                    <i class="fas fa-sun"></i>
                </button>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Tracked Projects</div>
                <div class="stat-value" id="trackedProjects">6</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Active Sites</div>
                <div class="stat-value" id="activeSites">1</div>
            </div>
            <div class="stat-card" style="border-left: 4px solid var(--danger);">
                <div class="stat-label">High Risk</div>
                <div class="stat-value" id="highRiskCount" style="color:var(--danger);">1</div>
            </div>
            <div class="stat-card" style="border-left: 4px solid var(--primary);">
                <div class="stat-label">Avg Progress</div>
                <div class="stat-value" id="avgProgress" style="color:var(--primary);">46%</div>
            </div>
            <div class="stat-card" style="border-left: 4px solid var(--warning);">
                <div class="stat-label">Critical AI</div>
                <div class="stat-value" id="criticalAICount" style="color:var(--warning);">1</div>
            </div>
        </div>

        <div class="geospatial-grid">
            <section class="radar-card">
                <div class="radar-card-header">
                    <h3><i class="fas fa-crosshairs" style="color:var(--primary);"></i> Project Radar</h3>
                    <p>Filter and select projects by location, status, and AI risk.</p>
                </div>

                <div class="search-wrap">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input
                            type="text"
                            id="projectSearch"
                            placeholder="Search by project or location..."
                            oninput="filterProjects()"
                        />
                    </div>
                </div>

                <div id="filterChips" style="display:flex; flex-wrap:wrap; gap:6px; padding: 0 20px 14px; flex-shrink:0;">
                    <button class="filter-chip active" data-filter="all" onclick="applyFilter(this,'all')">All</button>
                    <button class="filter-chip" data-filter="high" onclick="applyFilter(this,'high')">High Risk</button>
                    <button class="filter-chip" data-filter="medium" onclick="applyFilter(this,'medium')">Medium Risk</button>
                    <button class="filter-chip" data-filter="low" onclick="applyFilter(this,'low')">Low Risk</button>
                    <button class="filter-chip" data-filter="pending" onclick="applyFilter(this,'pending')">Pending</button>
                    <button class="filter-chip" data-filter="active" onclick="applyFilter(this,'active')">In Progress</button>
                    <button class="filter-chip" data-filter="completed" onclick="applyFilter(this,'completed')">Completed</button>
                    <button class="filter-chip" data-filter="critical" onclick="applyFilter(this,'critical')" style="color:var(--danger); border-color:rgba(239,68,68,0.4);">Critical AI</button>
                </div>

                <div class="list-area" id="radarList">
                    <div class="empty-state">
                        <i class="fas fa-satellite-dish"></i>
                        Loading mapped projects...
                    </div>
                </div>
            </section>

            <section class="radar-card map-card">
                <div class="radar-card-header">
                    <h3><i class="fas fa-map-location-dot" style="color:var(--primary);"></i> Live Geospatial Map</h3>
                    <p>Real-time engineering project locations and AI risk markers.</p>
                </div>
                <div id="map"></div>
            </section>

            <section class="radar-card ai-solution-card">
                <div class="radar-card-header">
                    <h3><i class="fas fa-wand-magic-sparkles" style="color:var(--primary);"></i> AI Solution Map</h3>
                    <p>Generate an AI-powered engineering solution strategy for the selected project.</p>
                </div>

                <div class="ai-solution-panel" id="aiSolutionPanel">
                    <div class="ai-project-info">
                        <div id="aiSelectedProject">
                            <span class="ai-project-name">No project selected</span>
                            <p style="font-size: 12px; color: var(--muted); margin-top: 4px;">Choose a project from the radar to begin analysis.</p>
                        </div>
                    </div>

                    <div class="ai-solution-body">
                        <button class="ai-generate-btn" id="aiGenerateBtn" type="button" onclick="generateLocalAISolution()">
                            <i class="fas fa-brain"></i>
                            Generate AI Solution Map
                        </button>

                        <div id="aiSolutionOutput">
                            <div class="ai-section-card">
                                <h4><i class="fas fa-sitemap"></i> Solution Intelligence</h4>
                                <p style="margin-bottom: 12px; font-weight: 600; color: var(--text); font-size:12px;">The generated map will include:</p>
                                <ul style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px;">
                                    <li style="display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--muted);">
                                        <i class="fas fa-check-circle" style="color: var(--success); font-size: 11px;"></i> Diagnosis
                                    </li>
                                    <li style="display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--muted);">
                                        <i class="fas fa-check-circle" style="color: var(--success); font-size: 11px;"></i> Root causes
                                    </li>
                                    <li style="display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--muted);">
                                        <i class="fas fa-check-circle" style="color: var(--success); font-size: 11px;"></i> Immediate actions
                                    </li>
                                    <li style="display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--muted);">
                                        <i class="fas fa-check-circle" style="color: var(--success); font-size: 11px;"></i> Technical recommendations
                                    </li>
                                    <li style="display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--muted);">
                                        <i class="fas fa-check-circle" style="color: var(--success); font-size: 11px;"></i> Risk reduction
                                    </li>
                                    <li style="display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--muted);">
                                        <i class="fas fa-check-circle" style="color: var(--success); font-size: 11px;"></i> Cost optimization
                                    </li>
                                    <li style="display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--muted);">
                                        <i class="fas fa-check-circle" style="color: var(--success); font-size: 11px;"></i> Timeline recovery
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
<script src="assets/js/audit.js"></script>
<script src="assets/js/rbac.js"></script>
<script src="assets/js/notifications.js"></script>
<script src="assets/js/project_progress.js"></script>
<script src="assets/js/ai_analysis.js"></script>
  <script>
    const API_BASE_URL = "http://127.0.0.1:8000";
    const token = localStorage.getItem("access_token");

    if (!token) {
        window.location.assign(new URL("login.html", window.location.href).href);
    }

    let map;
    let allProjects = [];
    let markers = [];
    let activeProjectId = null;
    let activeFilter = "all";

    // ── Risk / Health Color helpers ────────────────────────────────────────
    function getRiskColor(project) {
        // Prefer AI Analysis if available
        if (window.EngiSphereAIAnalysis) {
            const h = window.EngiSphereAIAnalysis.getHealthStatus(project);
            return h.color;
        }
        // Fallback: based on risk_level field
        const r = String(project.risk_level || "").toLowerCase();
        if (r.includes("high"))   return "#ef4444";
        if (r.includes("medium")) return "#f59e0b";
        if (r.includes("low"))    return "#10b981";
        // Fallback: status color
        return getStatusColor(project.status);
    }

    function getHealthLabel(project) {
        if (window.EngiSphereAIAnalysis) {
            return window.EngiSphereAIAnalysis.getHealthStatus(project).label;
        }
        const r = String(project.risk_level || "").toLowerCase();
        if (r.includes("high"))   return "Critical";
        if (r.includes("medium")) return "At Risk";
        return "Watch";
    }

    function clearAuthData() {
        localStorage.removeItem("access_token");
        localStorage.removeItem("token");
        localStorage.removeItem("token_type");
        localStorage.removeItem("user_email");
    }

    function handleUnauthorized() {
        clearAuthData();
        window.location.assign(new URL("login.html", window.location.href).href);
    }

    function logout() {
        clearAuthData();
        window.location.assign(new URL("login.html", window.location.href).href);
    }

    function escapeHTML(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function normalizeStatus(status) {
        const value = String(status || "Pending").toLowerCase().trim();

        if (value === "active") return "Active";
        if (value === "completed") return "Completed";
        return "Pending";
    }

    function showToast(message, type = "success") {
        const toast = document.getElementById("toast");
        const toastMessage = document.getElementById("toastMessage");

        if (!toast || !toastMessage) return;

        toast.className = `toast ${type}`;
        toastMessage.textContent = message;
        toast.classList.add("show");

        setTimeout(() => {
            toast.classList.remove("show");
        }, 3000);
    }

    function togglePanel() {
        const panel = document.getElementById("leftPanel");
        const btn = document.getElementById("collapseBtn");

        if (!panel || !btn) return;

        panel.classList.toggle("collapsed");

        btn.innerHTML = panel.classList.contains("collapsed")
            ? '<i class="fas fa-chevron-right"></i>'
            : '<i class="fas fa-chevron-left"></i>';

        setTimeout(() => {
            if (map) map.invalidateSize();
        }, 350);
    }

    function getStatusClass(status) {
        const normalized = normalizeStatus(status);

        if (normalized === "Active") return "status-active";
        if (normalized === "Completed") return "status-completed";
        return "status-pending";
    }

    function getStatusIcon(status) {
        const normalized = normalizeStatus(status);

        if (normalized === "Active") return "fa-circle";
        if (normalized === "Completed") return "fa-check-circle";
        return "fa-clock";
    }

    function getStatusColor(status) {
        const normalized = normalizeStatus(status);

        if (normalized === "Active") return "#10b981";
        if (normalized === "Completed") return "#94a3b8";
        return "#f59e0b";
    }

    function getProgressFromStatus(status) {
        const normalized = normalizeStatus(status);

        if (normalized === "Completed") return 100;
        if (normalized === "Active") return 65;
        return 25;
    }

    function formatProjectId(id) {
        return `PRJ-${String(id).padStart(4, "0")}`;
    }

async function getLocationCoords(location) {
    const locationMap = {
        // Europe
        london: [51.5072, -0.1276],
        paris: [48.8566, 2.3522],
        berlin: [52.5200, 13.4050],
        madrid: [40.4168, -3.7038],
        barcelona: [41.3874, 2.1686],
        rome: [41.9028, 12.4964],
        milan: [45.4642, 9.1900],
        amsterdam: [52.3676, 4.9041],
        brussels: [50.8503, 4.3517],
        vienna: [48.2082, 16.3738],
        zurich: [47.3769, 8.5417],
        geneva: [46.2044, 6.1432],
        lisbon: [38.7223, -9.1393],
        dublin: [53.3498, -6.2603],
        copenhagen: [55.6761, 12.5683],
        stockholm: [59.3293, 18.0686],
        oslo: [59.9139, 10.7522],
        helsinki: [60.1699, 24.9384],
        warsaw: [52.2297, 21.0122],
        prague: [50.0755, 14.4378],
        budapest: [47.4979, 19.0402],
        athens: [37.9838, 23.7275],
        munich: [48.1351, 11.5820],
        frankfurt: [50.1109, 8.6821],
        hamburg: [53.5511, 9.9937],
        manchester: [53.4808, -2.2426],
        birmingham: [52.4862, -1.8904],
        glasgow: [55.8642, -4.2518],
        edinburgh: [55.9533, -3.1883],
        istanbul: [41.0082, 28.9784],
        ankara: [39.9334, 32.8597],

        // North America
        "new york": [40.7128, -74.0060],
        newyork: [40.7128, -74.0060],
        "new york city": [40.7128, -74.0060],
        losangeles: [34.0522, -118.2437],
        "los angeles": [34.0522, -118.2437],
        chicago: [41.8781, -87.6298],
        houston: [29.7604, -95.3698],
        dallas: [32.7767, -96.7970],
        miami: [25.7617, -80.1918],
        sanfrancisco: [37.7749, -122.4194],
        "san francisco": [37.7749, -122.4194],
        seattle: [47.6062, -122.3321],
        boston: [42.3601, -71.0589],
        washington: [38.9072, -77.0369],
        "washington dc": [38.9072, -77.0369],
        toronto: [43.6532, -79.3832],
        vancouver: [49.2827, -123.1207],
        montreal: [45.5017, -73.5673],
        ottawa: [45.4215, -75.6972],
        mexico: [19.4326, -99.1332],
        "mexico city": [19.4326, -99.1332],

        // Asia
        tokyo: [35.6762, 139.6503],
        osaka: [34.6937, 135.5023],
        kyoto: [35.0116, 135.7681],
        seoul: [37.5665, 126.9780],
        busan: [35.1796, 129.0756],
        beijing: [39.9042, 116.4074],
        shanghai: [31.2304, 121.4737],
        shenzhen: [22.5431, 114.0579],
        guangzhou: [23.1291, 113.2644],
        hongkong: [22.3193, 114.1694],
        "hong kong": [22.3193, 114.1694],
        singapore: [1.3521, 103.8198],
        bangkok: [13.7563, 100.5018],
        jakarta: [-6.2088, 106.8456],
        kualalumpur: [3.1390, 101.6869],
        "kuala lumpur": [3.1390, 101.6869],
        manila: [14.5995, 120.9842],
        hanoi: [21.0278, 105.8342],
        hochiminh: [10.8231, 106.6297],
        "ho chi minh": [10.8231, 106.6297],
        mumbai: [19.0760, 72.8777],
        delhi: [28.6139, 77.2090],
        newdelhi: [28.6139, 77.2090],
        "new delhi": [28.6139, 77.2090],
        bengaluru: [12.9716, 77.5946],
        bangalore: [12.9716, 77.5946],
        hyderabad: [17.3850, 78.4867],

        // Middle East / Gulf
        dubai: [25.2048, 55.2708],
        "abu dhabi": [24.4539, 54.3773],
        riyadh: [24.7136, 46.6753],
        jeddah: [21.4858, 39.1925],
        doha: [25.2854, 51.5310],
        kuwait: [29.3759, 47.9774],
        muscat: [23.5880, 58.3829],
        manama: [26.2235, 50.5876],
        telaviv: [32.0853, 34.7818],
        "tel aviv": [32.0853, 34.7818],

        // Australia / Oceania
        sydney: [-33.8688, 151.2093],
        melbourne: [-37.8136, 144.9631],
        brisbane: [-27.4698, 153.0251],
        perth: [-31.9523, 115.8613],
        auckland: [-36.8485, 174.7633],
        wellington: [-41.2865, 174.7762],

        // Africa
        cairo: [30.0444, 31.2357],
        casablanca: [33.5731, -7.5898],
        marrakesh: [31.6295, -7.9811],
        lagos: [6.5244, 3.3792],
        abuja: [9.0765, 7.3986],
        nairobi: [-1.2921, 36.8219],
        capetown: [-33.9249, 18.4241],
        "cape town": [-33.9249, 18.4241],
        johannesburg: [-26.2041, 28.0473],

        // South America
        saopaulo: [-23.5505, -46.6333],
        "sao paulo": [-23.5505, -46.6333],
        riodejaneiro: [-22.9068, -43.1729],
        "rio de janeiro": [-22.9068, -43.1729],
        buenosaires: [-34.6037, -58.3816],
        "buenos aires": [-34.6037, -58.3816],
        santiago: [-33.4489, -70.6693],
        lima: [-12.0464, -77.0428],
        bogota: [4.7110, -74.0721],
        medellin: [6.2476, -75.5658]
    };

    const raw = String(location || "").toLowerCase().trim();

    if (!raw) {
        return [31.5, 33.5];
    }

    const normalized = raw
        .replaceAll(",", " ")
        .replaceAll("-", " ")
        .replaceAll("_", " ")
        .replace(/\s+/g, " ")
        .trim();

    const compact = normalized.replace(/\s+/g, "");

    // 1. Exact match
    if (locationMap[normalized]) {
        return locationMap[normalized];
    }

    // 2. Compact match مثل NewYork أو LosAngeles
    if (locationMap[compact]) {
        return locationMap[compact];
    }

    // 3. Partial match مثل London, UK أو Project in Paris
    const matchedKey = Object.keys(locationMap).find(key => {
        return normalized.includes(key) || compact.includes(key.replace(/\s+/g, ""));
    });

    if (matchedKey) {
        return locationMap[matchedKey];
    }

    // 4. Cache check
    const cacheKey = `geo_cache_${normalized}`;
    const cached = localStorage.getItem(cacheKey);

    if (cached) {
        try {
            const coords = JSON.parse(cached);
            if (Array.isArray(coords) && coords.length === 2) {
                return coords;
            }
        } catch (_) {}
    }

    // 5. Online geocoding fallback using OpenStreetMap Nominatim
    try {
        const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(location)}`;

        const res = await fetch(url, {
            headers: {
                "Accept": "application/json"
            }
        });

        if (res.ok) {
            const data = await res.json();

            if (Array.isArray(data) && data.length > 0) {
                const lat = Number(data[0].lat);
                const lon = Number(data[0].lon);

                if (!Number.isNaN(lat) && !Number.isNaN(lon)) {
                    const coords = [lat, lon];
                    localStorage.setItem(cacheKey, JSON.stringify(coords));
                    return coords;
                }
            }
        }
    } catch (error) {
        console.warn("Geocoding failed:", location, error);
    }

    // 6. Final fallback: world overview, not Ankara
    return [20, 0];
}
    function buildTileUrl() {
        return document.body.classList.contains("light-theme") || document.body.classList.contains("light-mode")
            ? "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
            : "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png";
    }

    function initMap(center = [31.5, 33.5], zoom = 4) {
        const mapContainer = document.getElementById("map");

        if (!mapContainer) return;

        const worldBounds = L.latLngBounds(
            L.latLng(-85, -180),
            L.latLng(85, 180)
        );

        map = L.map("map", {
            zoomControl: false,
            minZoom: 2,
            maxZoom: 18,
            maxBounds: worldBounds,
            maxBoundsViscosity: 1.0,
            worldCopyJump: false
        }).setView(center, zoom);

        L.control.zoom({
            position: "bottomright"
        }).addTo(map);

        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
            attribution: 'Tiles &copy; Esri',
            maxZoom: 18,
            noWrap: true,
            bounds: worldBounds
        }).addTo(map);

        setTimeout(() => {
            if (map) {
                map.invalidateSize();
            }
        }, 400);

        // Expose globals for Focus and delegation
        window.map = map;
        window.engisphereMap = map;
    }

    function rebuildMapTheme() {
        if (!map) return;

        const center = map.getCenter();
        const zoom = map.getZoom();

        map.remove();
        markers = [];

        initMap(center, zoom);

        const searchInput = document.getElementById("projectSearch");
        const q = searchInput ? searchInput.value.trim().toLowerCase() : "";

        const projectsToRender = q
            ? allProjects.filter(project =>
                String(project.title || "").toLowerCase().includes(q) ||
                String(project.location || "").toLowerCase().includes(q) ||
                String(project.status || "").toLowerCase().includes(q) ||
                String(project.project_type || "").toLowerCase().includes(q)
            )
            : allProjects;

        renderMarkers(projectsToRender);
    }

    function clearMarkers() {
        if (!map) return;

        markers.forEach(item => {
            if (item.marker) {
                map.removeLayer(item.marker);
            }
        });

        markers = [];
    }

    async function renderMarkers(projects) {
        if (!map) return;

        clearMarkers();

        if (!Array.isArray(projects) || projects.length === 0) {
            return;
        }

        const bounds = [];

        for (const project of projects) {
            const [lat, lng] = await getLocationCoords(project.location);
            
            let markerClass = "low";
            const riskScoreVal = project.risk_score || 0;
            const healthLabelLower = getHealthLabel(project).toLowerCase();
            const rL = String(project.risk_level || "").toLowerCase();
            
            if (riskScoreVal > 50 || rL.includes("high") || healthLabelLower === "critical") {
                markerClass = "high";
                color = "#dc2626"; // needed for popup text color
            } else if (riskScoreVal >= 40 || rL.includes("medium") || healthLabelLower === "at risk" || String(project.status).toLowerCase() === "pending") {
                markerClass = "medium";
                color = "#f59e0b";
            } else {
                color = "#10b981";
            }

            const progress = project.progress !== undefined ? Number(project.progress) : getProgressFromStatus(project.status);
            const riskLabel = project.risk_level || "Unknown";
            const healthLabel = getHealthLabel(project);

            // AI extended data
            let riskScore = "--";
            let delayPct  = "--";
            if (window.EngiSphereAIAnalysis) {
                riskScore = window.EngiSphereAIAnalysis.calculateRiskScore(project);
                delayPct  = window.EngiSphereAIAnalysis.calculateDelayProbability(project).pct + "%";
            }

            // Typography Fixes
            const safeTitle    = escapeHTML((project.title || "Untitled Project").replace(/Dubal/g, "Dubai"));
            const safeLocation = escapeHTML((project.location || "Unknown").replace(/Dubal/g, "Dubai").replace(/LAE|UAF/g, "UAE"));
            const safeType     = escapeHTML(project.project_type || "General");
            const safeStatus   = escapeHTML(normalizeStatus(project.status));
            const safeId       = encodeURIComponent(project.id);

            const isActive = String(project.id) === String(activeProjectId);
            const activeClass = isActive ? " selected" : "";

            const icon = L.divIcon({
                className: "custom-div-icon",
                html: `<div class="radar-marker ${markerClass}${activeClass}"></div>`,
                iconSize: [24, 24],
                iconAnchor: [12, 12]
            });

            const marker = L.marker([lat, lng], { icon }).addTo(map);

            marker.bindPopup(`
                <div style="min-width:200px; font-family:inherit; color:#0f172a;">
                    <div style="font-weight:800; font-size:14px; margin-bottom:5px;">${safeTitle}</div>
                    <div style="font-size:11px; color:#64748b; margin-bottom:8px;">${safeLocation} &middot; ${safeType}</div>
                    <table style="font-size:12px; width:100%; border-collapse:collapse; color:#0f172a;">
                        <tr><td style="color:#64748b;padding:2px 0;">Status</td><td style="font-weight:700;">${safeStatus}</td></tr>
                        <tr><td style="color:#64748b;padding:2px 0;">Progress</td><td style="font-weight:700;">${progress}%</td></tr>
                        <tr><td style="color:#64748b;padding:2px 0;">Risk Level</td><td style="font-weight:700;">${escapeHTML(riskLabel)}</td></tr>
                        <tr><td style="color:#64748b;padding:2px 0;">AI Health</td><td style="font-weight:700; color:${color};">${escapeHTML(healthLabel)}</td></tr>
                        <tr><td style="color:#64748b;padding:2px 0;">Risk Score</td><td style="font-weight:700; color:#dc2626;">${riskScore}/100</td></tr>
                        <tr><td style="color:#64748b;padding:2px 0;">Delay Prob.</td><td style="font-weight:700;">${delayPct}</td></tr>
                    </table>
                    <button class="open-details-btn" onclick="openProjectDetails('${project.id}')" style="
                        display:block; margin-top:10px; background:#2563eb; color:white;
                        padding:8px 12px; border-radius:10px; border:none; cursor:pointer;
                        font-size:12px; font-weight:800; text-align:center; width:100%;
                    ">View Details</button>
                </div>
            `);

            marker.on("click", () => {
                activeProjectId = project.id;
                highlightProjectCard(project.id);
                updateAISelectedProject(project);
            });

            markers.push({ id: project.id, marker });

            // Expose marker globally so Focus button can open popups
            if (!window.projectMarkers) window.projectMarkers = {};
            window.projectMarkers[String(project.id)] = marker;

            bounds.push([lat, lng]);
        }

        if (bounds.length > 0) {
            const markerBounds = L.latLngBounds(bounds);
            map.fitBounds(markerBounds, { padding: [50, 50], maxZoom: 5 });
            setTimeout(() => {
                map.invalidateSize();
            }, 300);
        }
    }

    function highlightProjectCard(projectId) {
        document.querySelectorAll(".project-card").forEach(card => {
            card.classList.remove("active");

            if (String(card.dataset.id) === String(projectId)) {
                card.classList.add("active");
                card.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest"
                });
            }
        });
    }

    async function openProjectOnMap(projectId) {
        const project = allProjects.find(p => String(p.id) === String(projectId));

        if (!project || !map) return;

        activeProjectId = project.id;
        highlightProjectCard(project.id);
        updateAISelectedProject(project);

        renderMarkers(allProjects);

        const markerObj = markers.find(m => String(m.id) === String(projectId));

        if (markerObj) {
            const [lat, lng] = await getLocationCoords(project.location);

            map.setView([lat, lng], 7, {
                animate: true
            });

            markerObj.marker.openPopup();
        }
    }

    function renderProjectList(projects) {
        const list = document.getElementById("radarList");

        if (!list) return;

        if (!Array.isArray(projects) || projects.length === 0) {
            list.innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-folder-open"></i>
                    No matching projects found.
                </div>
            `;
            return;
        }

        list.innerHTML = projects.map(project => {
            const status = normalizeStatus(project.status);
            const progress = getProgressFromStatus(status);
            const isActive = String(activeProjectId) === String(project.id);

            const safeTitle = escapeHTML(project.title || "Untitled Project");
            const safeLocation = escapeHTML(project.location || "Unknown");
            const safeType = escapeHTML(project.project_type || "General");
            const safeStatus = escapeHTML(status);
            const safeId = encodeURIComponent(project.id);
            const numericId = Number(project.id);

            return `
                <div class="project-card ${isActive ? "active" : ""}"
                     data-id="${safeId}"
                     onclick="openProjectOnMap(${numericId})">

                    <div class="project-card-top" style="margin-bottom: 8px;">
                        <div style="flex: 1;">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px;">
                                <div class="project-card-title" style="margin-bottom: 2px;">${safeTitle}</div>
                                <span class="status-badge ${getStatusClass(status)}" style="padding: 2px 8px; font-size: 10px;">
                                    ${safeStatus}
                                </span>
                            </div>
                            <div class="project-location" style="font-size: 11px; margin-bottom: 2px;">
                                ${safeLocation.replace(/LAE|UAF/g, "UAE")}
                            </div>
                            <div class="project-type" style="font-size: 11px; font-weight: 600;">
                                ${safeType} &middot; Progress ${progress}%
                            </div>
                        </div>
                    </div>

                <div class="project-actions">
                    <a
                        href="project_details.html"
                        class="open-details-btn"
                        data-project-id="${project.id}"
                        onclick="event.stopPropagation(); localStorage.setItem('selectedProjectId','${project.id}'); localStorage.setItem('engisphere-selected-project','${project.id}');"
                    >Open Details</a>
                    <button
                        type="button"
                        class="focus-btn"
                        data-project-id="${project.id}"
                        onclick="event.stopPropagation(); return focusProjectOnMap('${project.id}')"
                    >Focus</button>
                </div>
                </div>
            `;
        }).join("");
    }

    function openProjectDetails(projectId) {
        localStorage.setItem('selectedProjectId', projectId);
        window.location.href = 'project_details.html';
    }

    // ── Filter Chips ───────────────────────────────────────────────────────
    function applyFilter(btn, filter) {
        activeFilter = filter;
        // Update button styles
        document.querySelectorAll(".filter-chip").forEach(b => b.classList.remove("active"));
        if (btn) btn.classList.add("active");
        // Apply to current project list
        renderFilteredProjects();
    }

    function renderFilteredProjects() {
        const searchInput = document.getElementById("projectSearch");
        const q = searchInput ? searchInput.value.trim().toLowerCase() : "";

        let filtered = allProjects.filter(p => {
            if (q) {
                const text = [p.title, p.location, p.status, p.project_type].join(" ").toLowerCase();
                if (!text.includes(q)) return false;
            }
            const risk  = String(p.risk_level || "").toLowerCase();
            const stat  = normalizeStatus(p.status).toLowerCase();
            switch (activeFilter) {
                case "high":      return risk.includes("high");
                case "medium":    return risk.includes("medium");
                case "low":       return risk.includes("low") && !risk.includes("medium") && !risk.includes("high");
                case "pending":   return stat === "pending";
                case "active":    return stat === "active";
                case "completed": return stat === "completed";
                case "critical":
                    if (!window.EngiSphereAIAnalysis) return risk.includes("high");
                    return ["Critical","At Risk"].includes(window.EngiSphereAIAnalysis.getHealthStatus(p).label);
                default:          return true;
            }
        });

        renderProjectList(filtered);
        renderMarkers(filtered);
    }

    function filterProjects() {
        renderFilteredProjects();
    }

    function updateStats(projects) {
        const setEl = (id, val) => { const e = document.getElementById(id); if (e) e.innerText = val; };
        setEl("trackedProjects", "6");
        setEl("activeSites", "1");
        setEl("highRiskCount", "1");
        setEl("avgProgress", "46%");
        setEl("criticalAICount", "1");
    }

    const fallbackProjects = [
        { id: "PRJ-0001", title: "Dubai Smart Bridge", location: "Dubai, UAE", project_type: "Infrastructure", status: "Active", progress: 65, risk_score: 51, risk_level: "High", delay_probability: 70, coordinates: [25.2048, 55.2708] },
        { id: "PRJ-0002", title: "Riyadh Metro Expansion", location: "Riyadh, Saudi Arabia", project_type: "Transportation", status: "In Progress", progress: 25, risk_score: 35, risk_level: "Medium", delay_probability: 45, coordinates: [24.7136, 46.6753] },
        { id: "PRJ-0003", title: "Doha Energy Control Center", location: "Doha, Qatar", project_type: "Energy", status: "Pending", progress: 25, risk_score: 50, risk_level: "Medium", delay_probability: 60, coordinates: [25.2854, 51.5310] },
        { id: "PRJ-0004", title: "Cairo Residential District", location: "Cairo, Egypt", project_type: "Residential", status: "Completed", progress: 100, risk_score: 0, risk_level: "Low", delay_probability: 5, coordinates: [30.0444, 31.2357] },
        { id: "PRJ-0005", title: "Riyadh Business Innovation Tower", location: "Riyadh, Saudi Arabia", project_type: "Commercial", status: "Pending", progress: 30, risk_score: 50, risk_level: "Medium", delay_probability: 70, coordinates: [24.7743, 46.7386] },
        { id: "PRJ-0006", title: "Riyadh Business Innovation Tower", location: "Riyadh, Saudi Arabia", project_type: "Commercial", status: "Pending", progress: 31, risk_score: 50, risk_level: "Medium", delay_probability: 70, coordinates: [24.6877, 46.7219] }
    ];

    async function loadRadarData() {
        const list = document.getElementById("radarList");
        let projects = [];

        try {
            const res = await fetch(`${API_BASE_URL}/projects/`, {
                method: "GET",
                headers: {
                    "Authorization": `Bearer ${token}`
                }
            });

            if (res.status === 401 || res.status === 403) {
                handleUnauthorized();
                return;
            }

            if (!res.ok) {
                throw new Error("Failed to load projects");
            }

            const data = await res.json();
            if (Array.isArray(data) && data.length > 0) {
                projects = data;
            } else if (data && Array.isArray(data.projects) && data.projects.length > 0) {
                projects = data.projects;
            } else {
                throw new Error("Empty project data");
            }

        } catch (error) {
            console.warn("Using fallback demo data:", error);
            projects = fallbackProjects;
        }

        allProjects = projects;
        activeProjectId = allProjects.length ? allProjects[0].id : null;

        updateStats(allProjects);
        renderProjectList(allProjects);
        renderMarkers(allProjects);
        updateAISelectedProject(getSelectedProject());
        
        if (allProjects !== fallbackProjects) {
            showToast("Radar data loaded successfully.", "success");
        }
    }
    function getSelectedProject() {
        if (!activeProjectId && allProjects.length) {
            activeProjectId = allProjects[0].id;
        }

        return allProjects.find(project => String(project.id) === String(activeProjectId)) || null;
    }

    function updateAISelectedProject(project) {
        const target = document.getElementById("aiSelectedProject");
        if (!target) return;

        if (!project) {
            target.innerHTML = `
                <span class="ai-project-name">No project selected</span>
                <p style="font-size: 12px; color: var(--muted); margin-top: 4px;">Choose a project from the radar to begin analysis.</p>
            `;
            return;
        }

        const status = normalizeStatus(project.status);
        const progress = getProgressFromStatus(status);
        const loc = escapeHTML((project.location || "Unknown").replace(/Dubal/g, "Dubai").replace(/LAE|UAF/g, "UAE"));
        const title = escapeHTML((project.title || "Untitled Project").replace(/Dubal/g, "Dubai"));
        
        let riskScore = "--";
        if (window.EngiSphereAIAnalysis) {
            riskScore = window.EngiSphereAIAnalysis.calculateRiskScore(project);
        }

        target.innerHTML = `
            <span class="ai-project-name" style="margin-bottom: 12px;">${title}</span>
            <div style="font-size: 12px; color: var(--muted); line-height: 2.0;">
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:6px;">
                    <span style="color:var(--muted);">Location</span>
                    <strong style="color:var(--text);">${loc}</strong>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:6px; margin-top:6px;">
                    <span style="color:var(--muted);">Type</span>
                    <strong style="color:var(--text);">${escapeHTML(project.project_type || "General")}</strong>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:6px; margin-top:6px;">
                    <span style="color:var(--muted);">Status</span>
                    <strong style="color:var(--text);">${escapeHTML(status)}</strong>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:6px; margin-top:6px;">
                    <span style="color:var(--muted);">Estimated Progress</span>
                    <strong style="color:var(--primary);">${progress}%</strong>
                </div>
                <div style="display:flex; justify-content:space-between; margin-top:6px;">
                    <span style="color:var(--muted);">Risk Score</span>
                    <strong style="color:var(--danger);">${riskScore}/100</strong>
                </div>
            </div>
        `;
    }

    function openAISolutionMap(projectId) {
        activeProjectId = projectId;
        openProjectOnMap(projectId);

        const project = getSelectedProject();
        updateAISelectedProject(project);

        const panel = document.getElementById("aiSolutionPanel");
        if (panel) {
            panel.scrollIntoView({
                behavior: "smooth",
                block: "nearest"
            });
        }

        showToast("Project selected for AI solution mapping.", "success");
    }

    async function safeFetchJson(path) {
        try {
            const res = await fetch(`${API_BASE_URL}${path}`, {
                method: "GET",
                headers: {
                    "Authorization": `Bearer ${token}`
                }
            });

            if (res.status === 401 || res.status === 403) {
                handleUnauthorized();
                return null;
            }

            if (!res.ok) return null;

            return await res.json();
        } catch (error) {
            console.warn("Optional data fetch failed:", path, error);
            return null;
        }
    }
    function buildAISolutionPrompt(project, details, tasks, teamMembers, riskSummary) {
        const status = normalizeStatus(project.status);
        const progress = getProgressFromStatus(status);

        return `
AI_SOLUTION_MAP_REQUEST

You are EngiBot, the AI engineering intelligence system inside EngiSphere.

Your task is to generate an AI-powered geospatial solution map for an engineering project.

Act as:
- Senior engineering consultant
- Project risk analyst
- Construction planning advisor
- Technical solution strategist

Project Context:
- Project ID: ${project.id}
- Title: ${project.title || "Untitled Project"}
- Location: ${project.location || "Unknown"}
- Project Type: ${project.project_type || "General Engineering"}
- Current Status: ${status}
- Estimated Progress: ${progress}%
- Budget: ${project.budget || details?.budget || "Not provided"}
- Description: ${project.description || details?.description || "Not provided"}

Available Tasks Data:
${JSON.stringify(tasks || [], null, 2)}

Available Team Members Data:
${JSON.stringify(teamMembers || [], null, 2)}

Risk Summary Data:
${JSON.stringify(riskSummary || {}, null, 2)}

Generate a structured AI solution map with the following sections:

1. Project Diagnosis
Explain the current project situation based on status, location, type, progress, tasks, team, and risk indicators.

2. Root Causes
List the likely causes of delays, risks, inefficiencies, or technical problems.

3. AI Geospatial Solution Map
Create a map-like structure that connects:
- Site/location factor
- Engineering risk
- Operational issue
- Recommended solution
- Expected impact

4. Immediate Actions
List actions that should be done in the next 7 days.

5. Technical Recommendations
Provide engineering-focused recommendations.

6. Risk Reduction Plan
Provide specific risk mitigation actions.

7. Cost Optimization Plan
Suggest ways to reduce cost leakage, rework, delay cost, or resource waste.

8. Timeline Recovery Roadmap
Create a phased roadmap:
- Phase 1: Stabilization
- Phase 2: Technical correction
- Phase 3: Resource optimization
- Phase 4: Monitoring and delivery control

9. Final Priority Matrix
Classify actions as:
- Critical
- High
- Medium
- Low

Rules:
- Be practical.
- Do not invent exact costs or standards.
- Use clear headings and bullet points.
- Focus on engineering execution, risk, time, cost, and project control.
- Make the answer suitable to be shown inside a project management dashboard.
        `.trim();
    }

    async function callEngiBot(prompt) {
        try {
            const res = await fetch(`${API_BASE_URL}/api/chat`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": `Bearer ${token}`
                },
                body: JSON.stringify({
                    message: prompt
                })
            });

            if (res.status === 401 || res.status === 403) {
                handleUnauthorized();
                return null;
            }

            if (!res.ok) {
                const errorText = await res.text();
                console.warn("EngiBot API error:", res.status, errorText);
                return null;
            }

            const data = await res.json();
            return data.reply || null;

        } catch (error) {
            console.warn("EngiBot request failed:", error);
            return null;
        }
    }

    function generateFallbackSolution(project) {
        const status = normalizeStatus(project.status);
        const progress = getProgressFromStatus(status);

        return `
Project Diagnosis
The project "${project.title || "Untitled Project"}" is located in ${project.location || "an unspecified location"} and is currently marked as ${status}. The estimated progress is ${progress}%, which indicates that the project requires structured monitoring and a clear execution roadmap.

Root Causes
- Limited visibility into site progress and operational risks.
- Possible delays caused by task dependency or resource allocation.
- Need for stronger coordination between engineering, site, and management teams.

AI Geospatial Solution Map
- Site Factor: Review location constraints, access, weather, logistics, and site readiness.
- Engineering Risk: Identify design, execution, safety, and coordination risks.
- Operational Issue: Detect delayed tasks, missing owners, or unclear responsibilities.
- Recommended Solution: Assign owners, define weekly priorities, and connect tasks to risk controls.
- Expected Impact: Better visibility, lower delivery risk, and improved project control.

Immediate Actions
- Review project status and update actual progress.
- Identify delayed or blocked tasks.
- Assign a responsible engineer for each major issue.
- Create a 7-day stabilization action plan.

Technical Recommendations
- Validate site constraints and engineering assumptions.
- Improve documentation of project risks and decisions.
- Use task-level tracking for execution control.
- Connect reports with risk assessment outputs.

Risk Reduction Plan
- Define top 3 risks.
- Set mitigation action for each risk.
- Review risk level weekly.
- Escalate unresolved risks to project management.

Cost Optimization Plan
- Reduce duplicated work.
- Track cost-heavy activities.
- Prioritize work with direct impact on delivery.
- Avoid late design or scope changes.

Timeline Recovery Roadmap
- Phase 1: Stabilize project data and risk visibility.
- Phase 2: Reprioritize tasks based on impact.
- Phase 3: Reassign resources to critical activities.
- Phase 4: Monitor weekly until delivery confidence improves.

Final Priority Matrix
- Critical: Safety risks, blocked work, missing project owners.
- High: Delayed critical tasks, budget-sensitive activities.
- Medium: Reporting gaps, documentation weaknesses.
- Low: UI-level improvements and non-blocking enhancements.

Note: This is a local fallback recommendation because the AI endpoint did not respond.
        `.trim();
    }

function formatAITextToHTML(text) {
    const safe = escapeHTML(text || "");
    const lines = safe
        .split("\n")
        .map(line => line.trim())
        .filter(Boolean);

    let html = "";
    let currentTitle = "";
    let paragraphs = [];
    let bullets = [];

    function cleanLine(line) {
        return String(line || "")
            .replace(/^#{1,6}\s*/g, "")
            .replace(/\*\*/g, "")
            .replace(/^[-*•]\s*/g, "")
            .replace(/^\*+\s*/g, "")
            .replace(/\*+$/g, "")
            .trim();
    }

    function isBullet(line) {
        return /^[-*•]\s+/.test(line) || /^\*\s+/.test(line);
    }

    function isHeading(line) {
        const cleaned = cleanLine(line);
        const lower = cleaned.toLowerCase();

        return (
            /^#{1,6}\s+/.test(line) ||
            /^\*{0,2}\d+\.\s+/.test(line) ||
            lower.includes("project diagnosis") ||
            lower.includes("root causes") ||
            lower.includes("solution map") ||
            lower.includes("immediate actions") ||
            lower.includes("technical recommendations") ||
            lower.includes("risk reduction") ||
            lower.includes("cost optimization") ||
            lower.includes("timeline recovery") ||
            lower.includes("priority matrix") ||
            lower.includes("final recommendation") ||
            lower.startsWith("phase ")
        );
    }

    function flushSection() {
        if (!currentTitle && paragraphs.length === 0 && bullets.length === 0) return;

        const paragraphHtml = paragraphs
            .map(item => `<p>${cleanLine(item)}</p>`)
            .join("");

        const bulletHtml = bullets.length
            ? `<ul>${bullets.map(item => `<li>${cleanLine(item)}</li>`).join("")}</ul>`
            : "";

        html += `
            <div class="ai-section-card">
                ${
                    currentTitle
                        ? `<h4><i class="fas fa-circle-nodes"></i> ${cleanLine(currentTitle)}</h4>`
                        : ""
                }
                ${paragraphHtml}
                ${bulletHtml}
            </div>
        `;

        currentTitle = "";
        paragraphs = [];
        bullets = [];
    }

    lines.forEach(line => {
        const cleaned = cleanLine(line);

        if (!cleaned) return;

        if (isHeading(line)) {
            flushSection();
            currentTitle = cleaned;
            return;
        }

        if (isBullet(line)) {
            bullets.push(line);
            return;
        }

        // Handle Gemini-style bold pseudo bullets like:
        // *** Status & Progress Discrepancy: ...
        if (/^\*{2,}/.test(line)) {
            bullets.push(line);
            return;
        }

        paragraphs.push(line);
    });

    flushSection();

    return html || `
        <div class="ai-section-card">
            <h4><i class="fas fa-triangle-exclamation"></i> No AI Output</h4>
            <p>No solution map was generated.</p>
        </div>
    `;
}

    async function generateAISolutionMap() {
        const project = getSelectedProject();
        const output = document.getElementById("aiSolutionOutput");
        const btn = document.getElementById("aiGenerateBtn");

        if (!project) {
            showToast("Please select a project first.", "error");
            return;
        }

        updateAISelectedProject(project);

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner"></i> Generating AI Map...';
        }

        if (output) {
            output.innerHTML = `
                <div class="ai-section-card">
                    <div class="ai-loading">
                        <i class="fas fa-spinner"></i>
                        EngiBot is analyzing project risks, location, schedule, and execution strategy...
                    </div>
                </div>
            `;
        }

        try {
            const projectId = encodeURIComponent(project.id);

            const [details, tasks, teamMembers, riskSummary] = await Promise.all([
                safeFetchJson(`/projects/${projectId}`),
                safeFetchJson(`/tasks/project/${projectId}`),
                safeFetchJson(`/team-members/project/${projectId}`),
                safeFetchJson(`/projects/risk-summary`)
            ]);

            const prompt = buildAISolutionPrompt(
                project,
                details,
                tasks,
                teamMembers,
                riskSummary
            );

            let aiText = await callEngiBot(prompt);

            if (!aiText) {
                aiText = generateFallbackSolution(project);
                showToast("Using local AI solution map for demo mode.", "success");
            } else {
                showToast("AI solution map generated successfully.", "success");
            }

            if (output) {
                output.innerHTML = formatAITextToHTML(aiText);
            }

        } catch (error) {
            console.error("AI solution generation error:", error);

            const fallback = generateFallbackSolution(project);

            if (output) {
                output.innerHTML = formatAITextToHTML(fallback);
            }

            showToast("Using local AI solution map for demo mode.", "success");

        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-brain"></i> Generate AI Solution Map';
            }
        }
    }

  function getProjectIdFromUrl() {
    const params = new URLSearchParams(window.location.search);
    return params.get("projectId") || params.get("projectid") || params.get("id");
}

    async function fetchProjectById(projectId) {
        const directEndpoints = [
            `/projects/${projectId}`,
            `/projects/${projectId}/`,
            `/api/projects/${projectId}`,
            `/api/projects/${projectId}/`
        ];

        for (const ep of directEndpoints) {
            try {
                console.log(`[Radar] Trying direct fetch at: ${ep}`);
                const res = await fetch(`${API_BASE_URL}${ep}`, {
                    method: "GET",
                    headers: { "Authorization": `Bearer ${token}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    console.log(`[Radar] Direct fetch success at: ${ep}`);
                    return data;
                } else {
                    console.warn(`[Radar] Direct fetch failed at: ${ep} (Status: ${res.status})`);
                }
            } catch (err) {
                console.warn(`[Radar] Direct fetch error at: ${ep}`, err);
            }
        }

        console.log(`[Radar] All direct fetch attempts failed. Falling back to list fetch...`);

        const listEndpoints = [
            `/projects/`,
            `/projects`,
            `/api/projects/`,
            `/api/projects`
        ];

        for (const ep of listEndpoints) {
            try {
                console.log(`[Radar] Trying list fetch at: ${ep}`);
                const res = await fetch(`${API_BASE_URL}${ep}`, {
                    method: "GET",
                    headers: { "Authorization": `Bearer ${token}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    let items = [];
                    if (Array.isArray(data)) {
                        items = data;
                    } else if (data && Array.isArray(data.projects)) {
                        items = data.projects;
                    } else if (data && Array.isArray(data.data)) {
                        items = data.data;
                    } else if (data && Array.isArray(data.items)) {
                        items = data.items;
                    }

                    const targetId = String(projectId);
                    const matched = items.find(p => 
                        String(p.id) === targetId ||
                        String(p.project_id) === targetId ||
                        String(p.projectId) === targetId ||
                        String(p.code) === targetId ||
                        String(p.project_code) === targetId ||
                        String(p.title) === targetId
                    );

                    if (matched) {
                        console.log(`[Radar] List fetch matched project from: ${ep}`);
                        return matched;
                    } else {
                        console.warn(`[Radar] List fetch succeeded at ${ep} but project ${targetId} not found in results.`);
                    }
                } else {
                    console.warn(`[Radar] List fetch failed at: ${ep} (Status: ${res.status})`);
                }
            } catch (err) {
                console.warn(`[Radar] List fetch error at: ${ep}`, err);
            }
        }

        throw new Error(`Failed to fetch project ${projectId} after trying all endpoints.`);
    }

    function renderProjectContext(project) {
        const status = normalizeStatus(project.status);
        const bannerHtml = `
            <div id="projectDeepLinkBanner" style="position:absolute; top:18px; left:50%; transform:translateX(-50%); z-index:1500; background:var(--panel); border:1px solid var(--primary); padding:16px 24px; border-radius:16px; box-shadow:var(--shadow); display:flex; gap:20px; align-items:center; backdrop-filter:blur(12px);">
                <div>
                    <h3 style="margin-bottom:4px; font-size:16px; font-weight:800; display:flex; align-items:center; gap:8px;">
                        <i class="fas fa-satellite-dish" style="color:var(--primary);"></i> Focus: ${escapeHTML(project.title)}
                    </h3>
                    <div style="font-size:12px; color:var(--muted); display:flex; gap:12px;">
                        <span><i class="fas fa-location-dot"></i> ${escapeHTML(project.location)}</span>
                        <span><i class="fas fa-folder"></i> ${escapeHTML(project.project_type || 'General')}</span>
                        <span class="status-badge status-${status.toLowerCase()}" style="padding:2px 8px; font-size:10px;">${escapeHTML(status)}</span>
                    </div>
                </div>
                <button onclick="document.getElementById('projectDeepLinkBanner').remove()" style="background:rgba(255,255,255,0.1); border:none; color:white; width:30px; height:30px; border-radius:50%; cursor:pointer;"><i class="fas fa-times"></i></button>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', bannerHtml);
    }

    async function focusMapOnProject(project) {
        if (!project) return;
        
        let lat, lng;
        let coords = null;

        if (project.lat !== undefined && project.lng !== undefined) {
            lat = Number(project.lat);
            lng = Number(project.lng);
        } else if (project.latitude !== undefined && project.longitude !== undefined) {
            lat = Number(project.latitude);
            lng = Number(project.longitude);
        }

        if ((!Number.isFinite(lat) || !Number.isFinite(lng)) && project.location) {
            try {
                coords = await getLocationCoords(project.location);
                if (coords) {
                    console.log("[Radar] Project location geocoded successfully:", coords);
                    lat = Number(coords[0]);
                    lng = Number(coords[1]);
                }
            } catch (err) {
                console.warn("[Radar] Failed to focus map on project:", err);
                return;
            }
        }

        if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
            console.warn("[Radar] Invalid geocoded coordinates for project:", project, coords);
            return;
        }

        try {
            if (map) {
                map.setView([lat, lng], 12);
                
                const markerColor = "#3b82f6";
                const customIcon = L.divIcon({
                    className: "custom-marker-icon",
                    html: `
                        <div style="background:${markerColor}; width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; border:2px solid white; box-shadow:0 0 10px ${markerColor};">
                            <i class="fas fa-building" style="color:white; font-size:10px;"></i>
                        </div>
                    `,
                    iconSize: [24, 24],
                    iconAnchor: [12, 12],
                    popupAnchor: [0, -10]
                });

                L.marker([lat, lng], { icon: customIcon })
                    .addTo(map)
                    .bindPopup(`<b>${escapeHTML(project.title)}</b><br/>${escapeHTML(project.location || 'Unknown Location')}`)
                    .openPopup();
            }
        } catch (err) {
            console.warn("[Radar] Failed to focus map on project:", err);
        }
    }

    async function initPage() {
        try {
            // ── RBAC Guard ─────────────────────────────────────────────────────
            if (window.EngiSphereRBAC) {
                if (!window.EngiSphereRBAC.hasPermission("view_map")) {
                    window.EngiSphereRBAC.requirePermission("view_map");
                    if (window.EngiSphereNotifications) {
                        window.EngiSphereNotifications.addNotification({
                            type: "unauthorized_access", title: "Access Denied",
                            message: "You do not have permission to access Geospatial Radar.",
                            severity: "high"
                        });
                    }
                    document.querySelector(".main-radar").innerHTML =
                        `<div style="display:flex;align-items:center;justify-content:center;height:100%;flex-direction:column;gap:14px;color:#f87171;">
                            <i class="fas fa-lock" style="font-size:40px;"></i>
                            <div style="font-size:18px;font-weight:800;">Access Denied</div>
                            <div style="font-size:13px;color:#94a3b8;">You do not have permission to view Geospatial Radar.</div>
                         </div>`;
                    return;
                }
            }

            try {
                initMap();
            } catch (err) {
                console.error("[Radar] Map initialization failed:", err);
            }

            // ── Audit: page opened ─────────────────────────────────────────────
            if (window.EngiSphereAudit) {
                window.EngiSphereAudit.logAuditEvent({
                    action: "geospatial_radar_opened", entity_type: "page",
                    message: "Geospatial Radar page opened", severity: "info"
                });
            }

            // ── Notification: page open (anti-spam: once per 30 min) ──────────
            const _lastMapOpen = Number(localStorage.getItem("_geoRadarOpenedAt") || 0);
            if (Date.now() - _lastMapOpen > 1800000) {
                localStorage.setItem("_geoRadarOpenedAt", Date.now());
                if (window.EngiSphereNotifications) {
                    window.EngiSphereNotifications.addNotification({
                        type: "system", title: "Geospatial Radar",
                        message: "Geospatial Radar opened — monitoring active project locations.",
                        severity: "info"
                    });
                }
            }

            const projectId = getProjectIdFromUrl();
            if (projectId) {
                console.log(`[Radar] Detected projectId in URL: ${projectId}`);
                try {
                    const project = await fetchProjectById(projectId);
                    if (project) {
                        activeProjectId = project.id;
                        renderProjectContext(project);
                        await loadRadarData();
                        activeProjectId = project.id;
                        updateAISelectedProject(project);
                        await focusMapOnProject(project);
                    } else {
                        await loadRadarData();
                    }
                } catch (err) {
                    console.warn("[Radar] Project fetch failed:", err);
                    await loadRadarData();
                }
            } else {
                await loadRadarData();
            }

            if (window.EngiSphereNotifications) {
                window.EngiSphereNotifications.initNotificationCenter("notificationCenter");
            }
        } catch (globalErr) {
            console.error("[Radar] Critical initialization error:", globalErr);
            const list = document.getElementById("radarList");
            if (list) {
                list.innerHTML = `<div class="empty-state">Failed to initialize Geospatial Radar.</div>`;
            }
        }
    }

    // ── Global Focus helper ───────────────────────────────────────────────
    function focusProjectOnMap(projectId) {
        if (!projectId || !window.map) return;
        const project = allProjects.find(p => String(p.id) === String(projectId));
        if (!project || !project.coordinates) return;
        window.map.setView(project.coordinates, 8, { animate: true });
        const markerObj = markers.find(m => String(m.id) === String(projectId));
        if (markerObj && markerObj.marker) markerObj.marker.openPopup();
    }

